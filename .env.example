# ─── WhyNot Platform — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=thundercode
POSTGRES_PASSWORD=thundercode
POSTGRES_DB=thundercode

# ─── AI Provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: OpenAI fallback
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4
# OPENAI_VISION_MODEL=gpt-4o

# ─── Authentication ──────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string before production!
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-string-before-production

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3010/api/auth/github/callback

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3010/api/auth/google/callback

# ─── Stripe Billing ──────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Get this from: stripe listen --print-secret (or Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=

# URLs for Stripe checkout redirect
STRIPE_SUCCESS_URL=http://localhost:5183/billing?success=true
STRIPE_CANCEL_URL=http://localhost:5183/billing?canceled=true

# ─── Rate Limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_TEST_EXECUTION_MAX=50
RATE_LIMIT_TEST_GENERATION_MAX=50
RATE_LIMIT_MAX_REQUESTS=200

# ─── Frontend URLs ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5183
ADMIN_FRONTEND_URL=http://localhost:5184

# Frontend build-time vars (passed as Docker build args)
VITE_API_URL=/api
VITE_WS_URL=ws://localhost:3011
VITE_QA_LOOP_WS_URL=ws://localhost:3012

# ─── Misc ─────────────────────────────────────────────────────────────────────
SCREENSHOT_RETENTION_DAYS=30

# Test executor resource limits
# TEST_EXECUTOR_CPUS=2.0
# TEST_EXECUTOR_MEMORY=4G
# TEST_EXECUTOR_CPUS_RESERVED=1.0
# TEST_EXECUTOR_MEMORY_RESERVED=2G
