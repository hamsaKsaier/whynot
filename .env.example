# ─── WhyNot Platform — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# Lines marked # REQUIRED must be set before the app will start.
# Lines marked # OPTIONAL have sensible defaults.

# ─── Edition: Self-Hosted (open-source) ──────────────────────────────────────
# SELF_HOSTED=true runs the free, self-hostable edition: no billing, no
# subscription/credit/feature gates, a single admin account. Your app, your
# code, and your LLM key never leave your infrastructure.
# Leave false/unset for the hosted SaaS edition.
SELF_HOSTED=true              # OPTIONAL — true = self-hosted edition. default: false
AUTH_DISABLED=false           # OPTIONAL — self-hosted only: true auto-logs-in as admin (localhost/trusted only — NEVER when exposed)
ADMIN_EMAIL=                  # REQUIRED when SELF_HOSTED=true — your single admin login email
ADMIN_PASSWORD=               # REQUIRED when SELF_HOSTED=true — choose a strong password
ADMIN_NAME=Admin              # OPTIONAL — admin display name
# Then set ONE provider key below (ANTHROPIC_API_KEY / OPENAI_API_KEY /
# OPENROUTER_API_KEY …) and a SECRETS_ENCRYPTION_KEY (generate with:
# openssl rand -base64 32). Choose the model in the admin UI → AI Providers.

# ─── Host Ports ───────────────────────────────────────────────────────────────
# Host ports published by Docker Compose. Must be unique and not conflict with
# other containers running on this host. Override here to resolve conflicts —
# no compose edits required.
POSTGRES_PORT=5433            # OPTIONAL — host port for PostgreSQL (container always listens on 5432)
AI_SERVICE_PORT=8010          # OPTIONAL — host port for AI service
GATEWAY_PORT=3010             # OPTIONAL — host port for gateway API
TEST_EXECUTOR_PORT=3011       # OPTIONAL — host port for test executor
QA_LOOP_EXECUTOR_PORT=3012    # OPTIONAL — host port for QA loop executor
FRONTEND_PORT=5183            # OPTIONAL — host port for frontend
ADMIN_FRONTEND_PORT=5184      # OPTIONAL — host port for admin frontend

# ─── Database ─────────────────────────────────────────────────────────────────
# Either set DATABASE_URL directly, or supply the individual POSTGRES_* vars.
# DATABASE_URL=postgresql://whynot:whynot@database:5432/whynot  # OPTIONAL — overrides individual vars
POSTGRES_USER=whynot          # OPTIONAL — default: whynot
POSTGRES_PASSWORD=whynot      # OPTIONAL — default: whynot (change in production!)
POSTGRES_DB=whynot            # OPTIONAL — default: whynot
POSTGRES_HOST=database        # OPTIONAL — default: database (Docker service name)
POSTGRES_PORT_INTERNAL=5432   # OPTIONAL — internal container port, default: 5432

# ─── Authentication ──────────────────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET to a long random string before production!
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-string-before-production  # REQUIRED

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=             # REQUIRED for GitHub login
GITHUB_CLIENT_SECRET=         # REQUIRED for GitHub login
GITHUB_CALLBACK_URL=http://localhost:3010/api/auth/github/callback  # OPTIONAL

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=             # REQUIRED for Google login
GOOGLE_CLIENT_SECRET=         # REQUIRED for Google login
GOOGLE_CALLBACK_URL=http://localhost:3010/api/auth/google/callback  # OPTIONAL

# ─── Encryption ──────────────────────────────────────────────────────────────
# Keys used to encrypt stored secrets and integration tokens.
# Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=       # REQUIRED — AES-256 key, must be exactly 32 bytes base64-encoded
ENCRYPTION_KEY=               # REQUIRED — used for integration token encryption

# ─── Stripe Billing ──────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=            # REQUIRED for payments
STRIPE_PUBLISHABLE_KEY=       # REQUIRED for payments
# Get this from: stripe listen --print-secret (or Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=        # REQUIRED for payments

# Stripe product price IDs — create these in Stripe Dashboard > Products (test mode)
# See docs/en/payments/stripe-setup.md for a full walkthrough
STRIPE_PRICE_STARTER_MONTHLY=   # OPTIONAL — Stripe price ID
STRIPE_PRICE_STARTER_YEARLY=    # OPTIONAL — Stripe price ID
STRIPE_PRICE_PRO_MONTHLY=       # OPTIONAL — Stripe price ID
STRIPE_PRICE_PRO_YEARLY=        # OPTIONAL — Stripe price ID
STRIPE_PRICE_BUSINESS_MONTHLY=  # OPTIONAL — Stripe price ID
STRIPE_PRICE_BUSINESS_YEARLY=   # OPTIONAL — Stripe price ID
STRIPE_PRICE_ENTERPRISE_MONTHLY= # OPTIONAL — Stripe price ID
STRIPE_PRICE_ENTERPRISE_YEARLY=  # OPTIONAL — Stripe price ID
STRIPE_PRICE_PAYG_METERED=      # OPTIONAL — Stripe price ID

# URLs for Stripe checkout redirect
STRIPE_SUCCESS_URL=http://localhost:5183/billing?success=true    # OPTIONAL
STRIPE_CANCEL_URL=http://localhost:5183/billing?canceled=true    # OPTIONAL

# ── AI Providers ────────────────────────────────────────────────────────
# AI provider API keys are now managed via the admin dashboard:
#   https://admin.whynot.skrum.io/ai-providers
#
# The platform reads keys from the database (platform_ai_config table).
# See docs/en/ai/providers.md for details.
#
# For a SELF-HOSTED install, set ONE key here — it's the cold-start fallback
# the scanner uses when no key is configured in the admin dashboard. Both scan
# modes (single-agent and the 5-agent QA Team) read the same config, so any one
# of these providers is enough to run a scan.
#
# Google's free tier is the zero-cost path (key: aistudio.google.com).
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=gemini-flash-lite-latest
#
# Use `-latest` aliases, not pinned IDs like `gemini-2.5-flash`: Google retires
# specific versions for NEW API keys, so a pinned default fails on a fresh
# install with "no longer available to new users".
#
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Z_AI_API_KEY=

# ─── Email ────────────────────────────────────────────────────────────────────
# Email delivery via Resend.com. If RESEND_API_KEY is not set, emails are
# silently skipped (useful in local dev).
# RESEND_API_KEY=             # OPTIONAL — enables email delivery
# EMAIL_FROM_ADDRESS=WhyNot <notifications@whynot.qa>  # OPTIONAL

# ─── Rate Limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=200          # OPTIONAL — general API (per 15 min), default: 100
RATE_LIMIT_TEST_EXECUTION_MAX=50     # OPTIONAL — test execution (per hour), default: 10
RATE_LIMIT_TEST_GENERATION_MAX=50    # OPTIONAL — test generation (per 15 min), default: 20
RATE_LIMIT_QA_LOOP_MAX=5             # OPTIONAL — QA loop sessions (per hour), default: 5
RATE_LIMIT_LOGIN_MAX=10              # OPTIONAL — login attempts (per 15 min), default: 10
RATE_LIMIT_REGISTER_MAX=5            # OPTIONAL — registrations (per hour), default: 5
RATE_LIMIT_PUBLIC_MAX=10             # OPTIONAL — public endpoints (per 15 min), default: 10
RATE_LIMIT_LEAD_CAPTURE_MAX=10       # OPTIONAL — lead capture (per 15 min), default: 10

# ─── Frontend URLs ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5183           # OPTIONAL — main frontend URL
ADMIN_FRONTEND_URL=http://localhost:5184     # OPTIONAL — admin frontend URL
SUPERADMIN_FRONTEND_URL=http://localhost:5184 # OPTIONAL — alias for admin URL

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated additional origins (optional, for staging/preview envs).
# FRONTEND_URL and ADMIN_FRONTEND_URL are always included automatically.
# CORS_ALLOWED_ORIGINS=https://staging.whynot.skrum.io  # OPTIONAL

# ─── Frontend Build-Time Vars ─────────────────────────────────────────────────
# These are passed as Docker build args and baked into the frontend bundle.
VITE_API_URL=/api                            # OPTIONAL — default: /api
VITE_WS_URL=ws://localhost:3011              # OPTIONAL — test executor WebSocket
VITE_QA_LOOP_WS_URL=ws://localhost:3012      # OPTIONAL — QA loop WebSocket
# VITE_APP_VERSION=2.0.0                     # OPTIONAL — shown in frontend footer

# Admin frontend build arg
# ADMIN_VITE_API_URL=/api                    # OPTIONAL — default: /api

# ─── Admin Seed ───────────────────────────────────────────────────────────────
# ADMIN_EMAIL=admin@example.com              # OPTIONAL — seed a super_admin user on startup
# ADMIN_PASSWORD=changeme                    # OPTIONAL — password for the seeded admin
# ADMIN_NAME=Admin                           # OPTIONAL — display name (default: Admin)

# ─── Internal Service URLs ────────────────────────────────────────────────────
# Used by gateway to reach internal services. Defaults are Docker service names.
# AI_SERVICE_URL=http://ai-service:8000      # OPTIONAL — default: http://localhost:8000
# TEST_EXECUTOR_URL=http://test-executor:3001  # OPTIONAL — default: http://localhost:3001
# QA_LOOP_EXECUTOR_URL=http://qa-loop-executor:3002  # OPTIONAL — default: http://localhost:3002
# GATEWAY_URL=http://localhost:3010          # OPTIONAL — gateway's own URL
# APP_URL=                                   # OPTIONAL — app URL for billing links

# ─── File Storage & Cleanup ───────────────────────────────────────────────────
SCREENSHOT_RETENTION_DAYS=30                 # OPTIONAL — default: 30
# SCREENSHOTS_DIR=./screenshots              # OPTIONAL
# VISUAL_DIFFS_DIR=./visual-diffs            # OPTIONAL
# VIDEO_DIR=/tmp/videos                      # OPTIONAL

# ─── Browser & Test Configuration ─────────────────────────────────────────────
# SCREENSHOT_TIMEOUT_MS=10000                # OPTIONAL — default: 10000
# NAVIGATION_TIMEOUT_MS=30000                # OPTIONAL — default: 30000
# NAVIGATION_MAX_TIMEOUT_MS=60000            # OPTIONAL — default: 60000
# PAGE_CAPTURE_TIMEOUT_MS=60000              # OPTIONAL — default: 60000
# PAGE_CAPTURE_MAX_RETRIES=2                 # OPTIONAL — default: 2

# ─── Visual Regression ────────────────────────────────────────────────────────
# VISUAL_REGRESSION_ENABLED=true             # OPTIONAL — default: true
# VISUAL_REGRESSION_AUTO_BASELINE=true       # OPTIONAL — default: true
# VISUAL_REGRESSION_DIFF_DIR=./visual-diffs  # OPTIONAL
# VISUAL_REGRESSION_PIXEL_THRESHOLD=0.01     # OPTIONAL — default: 0.01
# VISUAL_REGRESSION_AI_ANALYSIS_ENABLED=true # OPTIONAL — default: true
# VISUAL_REGRESSION_GENERATE_DIFF=true       # OPTIONAL — default: true

# ─── Browser Preview / Streaming ──────────────────────────────────────────────
# PREVIEW_FRAME_INTERVAL_MS=50              # OPTIONAL — default: 50
# PREVIEW_MAX_HISTORY_FRAMES=100            # OPTIONAL — default: 100
# PREVIEW_SCREENSHOT_TYPE=jpeg              # OPTIONAL — default: jpeg
# PREVIEW_JPEG_QUALITY=85                   # OPTIONAL — default: 85
# PREVIEW_FULL_PAGE=false                   # OPTIONAL — default: false

# ─── QA Loop WebSocket ────────────────────────────────────────────────────────
# QA_LOOP_WS_SECRET=your-secret-here        # OPTIONAL — HMAC secret for WS auth (default: dev-secret)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5183,http://localhost:5184  # OPTIONAL
# WEBHOOK_AUTH_OPTIONAL=false               # OPTIONAL — set to true for backwards compat

# ─── Observability ────────────────────────────────────────────────────────────
# LOG_LEVEL=info                             # OPTIONAL — debug | info | warn | error

# ─── Test Executor Resource Limits ────────────────────────────────────────────
# TEST_EXECUTOR_CPUS=2.0                    # OPTIONAL — Docker CPU limit
# TEST_EXECUTOR_MEMORY=4G                   # OPTIONAL — Docker memory limit
# TEST_EXECUTOR_CPUS_RESERVED=1.0           # OPTIONAL — Docker CPU reservation
# TEST_EXECUTOR_MEMORY_RESERVED=2G          # OPTIONAL — Docker memory reservation

# ─── Misc ─────────────────────────────────────────────────────────────────────
# NODE_ENV=development                       # OPTIONAL — development | production | test
# ALLOW_INTERNAL_SCAN=false                  # OPTIONAL — allow scanning private networks (dangerous!)
# PORT=3000                                  # OPTIONAL — gateway listen port inside container
# VIDEO_FRAME_INTERVAL_MS=2000              # OPTIONAL — QA loop frame capture interval

# ---------- Experimental ----------
# Bug Verifier agent: after the specialists finish, re-runs each reported bug's
# reproduction steps and marks it confirmed / false_positive.
# OFF by default — it is NOT yet reliable. In testing it inverted verdicts
# (confirmed a fabricated bug, rejected a real one) because re-observing a page
# hits the same single-page-app ambiguity that caused the bad report. Enable
# only if you are working on it.
# ENABLE_BUG_VERIFIER=false
