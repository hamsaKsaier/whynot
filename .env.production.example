# ============================================================================
# WhyNot Platform -- Production Environment Variables
# ============================================================================
# Copy to .env and fill in all values before deploying.
# On Railway, set these as service-level environment variables.
# Variables marked [REQUIRED] must be set. Others have sensible defaults.
# ============================================================================

# ── Database (Railway Postgres plugin provides DATABASE_URL automatically) ────
# [REQUIRED] Full connection string. Railway sets this automatically when you
# add the Postgres plugin. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Only needed if running your own Postgres (not Railway plugin):
# POSTGRES_USER=whynot
# POSTGRES_PASSWORD=<strong-random-password>
# POSTGRES_DB=whynot

# ── AI Provider ──────────────────────────────────────────────────────────────
# [REQUIRED] At least one AI provider API key must be set.
LLM_PROVIDER=anthropic

# Anthropic (recommended)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (alternative / fallback)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4
# OPENAI_VISION_MODEL=gpt-4o

# ── Authentication ───────────────────────────────────────────────────────────
# [REQUIRED] Generate with: openssl rand -base64 64
JWT_SECRET=

# [REQUIRED] GitHub OAuth -- https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set to your gateway's public URL + /api/auth/github/callback
GITHUB_CALLBACK_URL=https://api.yourdomain.com/api/auth/github/callback

# Google OAuth -- https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback

# ── Stripe Billing ───────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret -- get from Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=
# Redirect URLs after Stripe checkout
STRIPE_SUCCESS_URL=https://app.yourdomain.com/billing?success=true
STRIPE_CANCEL_URL=https://app.yourdomain.com/billing?canceled=true

# ── Service URLs (internal networking) ───────────────────────────────────────
# On Railway, use Railway's internal networking via private domains.
# Format: http://<service-name>.railway.internal:<port>
AI_SERVICE_URL=http://ai-service.railway.internal:8000
TEST_EXECUTOR_URL=http://test-executor.railway.internal:3001
QA_LOOP_EXECUTOR_URL=http://qa-loop-executor.railway.internal:3002

# ── Public URLs ──────────────────────────────────────────────────────────────
# [REQUIRED] The public-facing URLs for each frontend and the gateway.
FRONTEND_URL=https://app.yourdomain.com
ADMIN_FRONTEND_URL=https://admin.yourdomain.com

# ── Frontend Build Args (set on frontend services at build time) ─────────────
# The API URL the frontend uses. On Railway with separate services, set this
# to the gateway's public URL.
VITE_API_URL=https://api.yourdomain.com/api

# WebSocket URLs for real-time test streaming. Must be publicly accessible.
VITE_WS_URL=wss://test-executor.yourdomain.com
VITE_QA_LOOP_WS_URL=wss://qa-loop.yourdomain.com

# Admin frontend API URL
ADMIN_VITE_API_URL=https://api.yourdomain.com/api

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins for AI service (comma-separated)
CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com,https://api.yourdomain.com

# ── Rate Limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_TEST_EXECUTION_MAX=50
RATE_LIMIT_TEST_GENERATION_MAX=50
RATE_LIMIT_MAX_REQUESTS=200

# ── Misc ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
SCREENSHOT_RETENTION_DAYS=30

# Allow scanning internal/private network targets (set false in production)
ALLOW_INTERNAL_SCAN=false

# ── Test Executor Tuning ─────────────────────────────────────────────────────
SCREENSHOT_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000
NAVIGATION_MAX_TIMEOUT_MS=60000
VISUAL_REGRESSION_ENABLED=true
VISUAL_REGRESSION_AI_ANALYSIS_ENABLED=true
