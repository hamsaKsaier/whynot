# ─── WhyNot Platform — Test Environment ──────────────────────────────────────
# Minimal env vars for running tests via docker-compose.test.yml.
# These override .env values for the test context.

NODE_ENV=test

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=whynot
POSTGRES_PASSWORD=whynot
POSTGRES_DB=whynot_test
DATABASE_URL=postgresql://whynot:whynot@postgres-test:5432/whynot_test

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=test-jwt-secret-do-not-use-in-production

# ─── Encryption (test-only keys — NOT for production) ────────────────────────
SECRETS_ENCRYPTION_KEY=dGVzdC1lbmNyeXB0aW9uLWtleS0zMi1ieXRlcyE=
ENCRYPTION_KEY=test-encryption-key-not-for-production

# ─── Frontend URLs ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5183
ADMIN_FRONTEND_URL=http://localhost:5184
VITE_API_URL=/api
